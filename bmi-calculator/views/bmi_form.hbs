<div class="container">
    <!-- Display the calculator heading -->
    <h1>Body Mass Index Calculator</h1>

    <h2>Enter your data</h2>

    <!-- Form to collect height and weight -->
    <form action="/calculate" method="GET">

        <!-- Enter height in meters -->
        <div class="form-row">
            <label for="height">Height in meters:</label>
            <input type="number" id="height" name="height" step="any" min="0.01" value="1.7" required>
        </div>

        <!-- Enter weight in kilograms -->
        <div>
            <label for="weight">Weight in kilograms:</label>
            <input type="number" id="weight" name="weight" step="any" min="0.01" value="75" required>
        </div>

        <!-- Submit the form -->
        <button type="submit">Calculate</button>

    </form>
</div>